{
  "info": {
    "name": "ShopEasy — E-Commerce Microservices",
    "description": "Complete API collection for ShopEasy microservices.\n\n**Setup:**\n1. Start all services (docker-compose up -d)\n2. Run 'Admin Login' (admin / Admin@123) OR 'Register + Login' as customer\n3. {{token}} is auto-saved — all requests use it via Bearer auth\n\n**Default Admin Credentials:** username=admin, password=Admin@123\n\n**Test Card Numbers:**\n- 4242424242424242  → Payment SUCCESS\n- 4000000000000002  → Card DECLINED\n- 4000000000009995  → Insufficient funds\n- 4000000000000069  → Expired card",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token",   "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register Customer",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.token) { pm.collectionVariables.set('token', r.token); pm.collectionVariables.set('userId', r.userId); }"
          ], "type": "text/javascript" }}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"mobileNumber\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Customer Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.token) { pm.collectionVariables.set('token', r.token); pm.collectionVariables.set('userId', r.userId); }"
          ], "type": "text/javascript" }}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Admin Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "var r = pm.response.json();",
            "if (r.token) { pm.collectionVariables.set('token', r.token); pm.collectionVariables.set('userId', r.userId); }"
          ], "type": "text/javascript" }}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}" }
          }
        }
      ]
    },

    {
      "name": "🛡️ Admin — User Management",
      "description": "Requires ADMIN token. Run 'Admin Login' first.",
      "item": [
        {
          "name": "List All Customers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/customers" }
        },
        {
          "name": "Disable Customer (id=2)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/admin/customers/2/disable" }
        },
        {
          "name": "Enable Customer (id=2)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/admin/customers/2/enable" }
        },
        {
          "name": "Delete Customer (id=2)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/customers/2" }
        },
        {
          "name": "Create Admin Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/admin/admins",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin2\",\n  \"password\": \"Admin@456\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Admin\",\n  \"mobileNumber\": \"9000000001\"\n}" }
          }
        },
        {
          "name": "List All Admins",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/admins" }
        },
        {
          "name": "Delete Admin (id=3)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/admins/3" }
        }
      ]
    },

    {
      "name": "📦 Products",
      "item": [
        {
          "name": "Get All Products (Public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Get Product by ID (Public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/1" }
        },
        {
          "name": "Search Products (Public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/search?q=laptop" }
        },
        {
          "name": "Filter by Category (Public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/category/Electronics" }
        },
        {
          "name": "Create Product (Admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Gaming Mouse\",\n  \"description\": \"High-DPI wireless gaming mouse with RGB\",\n  \"price\": 49.99,\n  \"stock\": 100,\n  \"category\": \"Electronics\",\n  \"imageUrl\": \"\"\n}" }
          }
        },
        {
          "name": "Update Product (Admin only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/1",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Laptop Pro\",\n  \"description\": \"Latest edition with improved battery\",\n  \"price\": 1199.99,\n  \"stock\": 25,\n  \"category\": \"Electronics\"\n}" }
          }
        },
        {
          "name": "Delete Product (Admin only)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/10" }
        }
      ]
    },

    {
      "name": "🛒 Cart",
      "description": "Requires CUSTOMER token.",
      "item": [
        {
          "name": "Get My Cart",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cart" }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/cart/add",
            "body": { "mode": "raw", "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}" }
          }
        },
        {
          "name": "Update Cart Item Qty",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/cart/items/1?quantity=3" }
        },
        {
          "name": "Remove Cart Item",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/items/1" }
        },
        {
          "name": "Clear Cart",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/clear" }
        },
        {
          "name": "Get Customer Cart (Admin only)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cart/customer/2" }
        }
      ]
    },

    {
      "name": "📋 Orders",
      "item": [
        {
          "name": "Place Order — SUCCESS card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/orders",
            "body": { "mode": "raw", "raw": "{\n  \"shippingAddress\": \"123 Main Street, Bangalore, KA 560001\",\n  \"cardNumber\": \"4242424242424242\",\n  \"cardExpiry\": \"12/26\",\n  \"cardCvv\": \"123\",\n  \"cardHolderName\": \"John Doe\"\n}" }
          }
        },
        {
          "name": "Place Order — DECLINED card",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/orders",
            "body": { "mode": "raw", "raw": "{\n  \"shippingAddress\": \"123 Main Street, Bangalore, KA 560001\",\n  \"cardNumber\": \"4000000000000002\",\n  \"cardExpiry\": \"12/26\",\n  \"cardCvv\": \"123\",\n  \"cardHolderName\": \"John Doe\"\n}" }
          }
        },
        {
          "name": "Get My Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" }
        },
        {
          "name": "Get Order by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/1" }
        },
        {
          "name": "Get ALL Orders (Admin only)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/all" }
        }
      ]
    },

    {
      "name": "💳 Payments",
      "item": [
        {
          "name": "My Payment History",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/my" }
        },
        {
          "name": "Get Payment by Order ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/order/1" }
        },
        {
          "name": "Get ALL Payments (Admin only)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/payments/all" }
        }
      ]
    }

  ]
}
